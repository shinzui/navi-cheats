% seihou

# Install master plan skill
seihou run --var intentions.enabled=true --commit master-plan

# Install exec plan skill
seihou run --var intentions.enabled=true --commit exec-plan

# Create GitHub repo
seihou run --var git.createGithub=true --commit git-init

# Create a new repo (new dir + git init + GitHub repo; owner from context config)
seihou run github-repo --var repo.parentDir="<parent_dir>" --var repo.name="<repo_name>" --var git.githubVisibility="<visibility>"

# Create a new repo under an explicit owner (new dir + git init + GitHub repo)
seihou run github-repo --var repo.parentDir="<parent_dir>" --var repo.name="<repo_name>" --var git.githubOwner="<owner>" --var git.githubVisibility="<visibility>"

$ parent_dir: echo '. ~ ~/Keikaku/bokuno ~/Work' | tr ' ' '\n'
$ visibility: echo 'private public internal' | tr ' ' '\n'

# Run hackage release blueprint
seihou agent run hackage-release
